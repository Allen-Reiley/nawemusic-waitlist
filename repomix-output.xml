    if (!token) {
      router.push('/');
      return;
    }

    const verify = async () => {
      try {
        const data = await verifyEmailToken(token);
        setUserData(data);
        setStatus('success');
      } catch (err) {
        console.error("Verification failed", err);
        setStatus('error');
      }
    };

    verify();
